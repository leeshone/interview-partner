{
  "name": "interview-partner",
  "version": "1.0.0",
  "private": true,
  "description": "Realistic mock-interview practice with voice and text, powered by the Hopscotch API.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "cross-env NODE_USE_ENV_PROXY=1 tsx watch --clear-screen=false src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production NODE_USE_ENV_PROXY=1 tsx src/server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "tsx": "^4.23.15",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "mermaid": "^12.3.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
